# SLIMS Environment Configuration Example
# Copy this file to .env and fill in the values before running the application.

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Ensure sslmode=require is used in production.
DATABASE_URL="postgresql://user:pass@host:5432/slims?sslmode=require"

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key used for signing JWT tokens and securing NextAuth.
# IMPORTANT: DO NOT USE A WEAK SECRET IN PRODUCTION.
# Generate a secure random string using: `openssl rand -base64 32`
AUTH_SECRET="your-secure-random-32-char-string-here"

# Required when deploying behind reverse proxies / Cloudflare Tunnel
AUTH_TRUST_HOST=true
NEXTAUTH_URL="https://slims.yourdomain.com"

# -----------------------------------------------------------------------------
# SEED DATA
# -----------------------------------------------------------------------------
# Password for the default administrator account created during `prisma db seed`.
# Must meet complexity requirements (min 8 chars, uppercase, lowercase, number).
SEED_ADMIN_PASSWORD="YourSecureAdminPassword123!"
